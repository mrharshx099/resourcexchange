# Server Environment Configuration
PORT=5001
NODE_ENV=production

# Security - Change this to a secure random string in production
JWT_SECRET=resourcexchange-hackathon-jwt-secret-2026

# CORS - Set to your deployed frontend domain (e.g., https://resourcexchange.vercel.app)
# Leave blank or omit to allow all origins temporarily during testing
FRONTEND_URL=

# SQLite Database path - defaults to local resourcexchange.db
# On persistent storage volumes (e.g. Railway volume /data), set to /data/resourcexchange.db
DB_PATH=
